import cv2
import mediapipe as mp
import os
from DeteccioMoviment import SistemaJocUniversal 

BaseOptions = mp.tasks.BaseOptions
PoseLandmarker = mp.tasks.vision.PoseLandmarker
PoseLandmarkerOptions = mp.tasks.vision.PoseLandmarkerOptions
HandLandmarker = mp.tasks.vision.HandLandmarker
HandLandmarkerOptions = mp.tasks.vision.HandLandmarkerOptions
VisionRunningMode = mp.tasks.vision.RunningMode

DIRECTORI_ACTUAL = os.path.dirname(os.path.abspath(__file__))
RUTA_COS = os.path.join(DIRECTORI_ACTUAL, 'pose_landmarker_full.task')
RUTA_MANS = os.path.join(DIRECTORI_ACTUAL, 'hand_landmarker.task')

opcions_cos = PoseLandmarkerOptions(
    base_options=BaseOptions(model_asset_path=RUTA_COS), 
    running_mode=VisionRunningMode.IMAGE, 
    output_segmentation_masks=False
)

# 🎯 CALIBRAT DE PRECISIÓ: Valor d'enginyeria òptim per llegir els 21 punts sense soroll
opcions_mans = HandLandmarkerOptions(
    base_options=BaseOptions(model_asset_path=RUTA_MANS), 
    running_mode=VisionRunningMode.IMAGE, 
    num_hands=1, # Fixem 1 mà dominat per evitar encreuaments de dits fantasma
    min_hand_detection_confidence=0.25, 
    min_hand_presence_confidence=0.25
)

detector_cos = PoseLandmarker.create_from_options(opcions_cos)
detector_mans = HandLandmarker.create_from_options(opcions_mans)

cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)

joc = SistemaJocUniversal()
llista_lletres = ["A", "B", "C", "D", "E", "F", "G", "H", "I", "L", "O", "P", "Q", "R", "S", "T", "U", "V", "W", "Y"]
index_actual = 0
joc.iniciar_nivell(llista_lletres[index_actual])
ha_canviat_nivell = False

print("\n--- INICIAT MOTOR DE 21 PUNTS INTEGRATS ULTRA-FLUID ---")

while cap.isOpened():
    success, frame = cap.read()
    if not success: break

    h, w, _ = frame.shape
    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)

    results_cos = detector_cos.detect(mp_image)
    results_mans = detector_mans.detect(mp_image)

    capa_dibuix = frame.copy()

    # Dibuixar punts corporals essencials
    if results_cos.pose_landmarks:
        for pose_landmarks in results_cos.pose_landmarks:
            for idx in [11, 12, 13, 14]:
                cx, cy = int(pose_landmarks[idx].x * w), int(pose_landmarks[idx].y * h)
                cv2.circle(capa_dibuix, (cx, cy), 6, (255, 0, 0), -1)

    # Dibuixar l'esquelet complet de 21 punts clau connectats de la mà
    if results_mans.hand_landmarks:
        for hand_landmarks in results_mans.hand_landmarks:
            color_ma = (0, 255, 0)
            # Pintar cadascun dels 21 nodes individuals
            for lm in hand_landmarks:
                cx, cy = int(lm.x * w), int(lm.y * h)
                cv2.circle(capa_dibuix, (cx, cy), 5, color_ma, -1)
            # Unir totes les falanges anatòmiques
            for t in range(5):
                base = t * 4 + 1
                for d in range(3):
                    p1 = (int(hand_landmarks[base+d].x * w), int(hand_landmarks[base+d].y * h))
                    p2 = (int(hand_landmarks[base+d+1].x * w), int(hand_landmarks[base+d+1].y * h))
                    cv2.line(capa_dibuix, p1, p2, (255, 255, 255), 2)
                # Connectar la base del dit al canell
                p_canell = (int(hand_landmarks[0].x * w), int(hand_landmarks[0].y * h))
                p_base_dit = (int(hand_landmarks[base].x * w), int(hand_landmarks[base].y * h))
                cv2.line(capa_dibuix, p_canell, p_base_dit, (255, 255, 255), 1)

    # Processar la lògica combinada del joc
    text_pantalla, color_text, es_correcte = joc.actualitzar(results_cos, results_mans)

    if es_correcte:
        if not ha_canviat_nivell: ha_canviat_nivell = True
    else:
        if ha_canviat_nivell:
            index_actual = (index_actual + 1) % len(llista_lletres)
            joc.iniciar_nivell(llista_lletres[index_actual])
            ha_canviat_nivell = False

    # Inversió mirall estètica per a la pantalla
    frame_final = cv2.flip(capa_dibuix, 1)

    # Interfície gràfica de text
    if es_correcte:
        cv2.rectangle(frame_final, (w//2 - 250, h//2 - 65), (w//2 + 250, h//2 + 25), (0, 0, 0), -1)
        cv2.putText(frame_final, text_pantalla, (w//2 - 220, h//2 + 5), cv2.FONT_HERSHEY_DUPLEX, 1.5, color_text, 3, cv2.LINE_AA)
    else:
        cv2.rectangle(frame_final, (10, 10), (680, 55), (0, 0, 0), -1)
        cv2.putText(frame_final, text_pantalla, (20, 38), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color_text, 2, cv2.LINE_AA)

    cv2.imshow('Joc Llengua de Signes - Mode 21 Punts Definitiu', frame_final)
    if cv2.waitKey(1) & 0xFF == ord('q'): break

cap.release()
cv2.destroyAllWindows()
detector_cos.close()
detector_mans.close()