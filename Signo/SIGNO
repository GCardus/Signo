class Button:
    def __init__(self, x, y, w, h, text, color=BLUE, hover_color=DARK_BLUE):
        self.rect = pygame.Rect(x, y, w, h)
        self.text = text
        self.color = color
        self.hover_color = hover_color
        self.current_color = color

    def draw(self, surface):
        mouse = pygame.mouse.get_pos()
        if self.rect.collidepoint(mouse):
            self.current_color = self.hover_color
        else:
            self.current_color = self.color

        shadow_rect = self.rect.inflate(10, 10)
        shadow_surf = pygame.Surface((shadow_rect.width, shadow_rect.height), pygame.SRCALPHA)
        pygame.draw.rect(shadow_surf, (0, 0, 0, 100), (5, 5, self.rect.width, self.rect.height), border_radius=15)
        surface.blit(shadow_surf, (self.rect.x - 5, self.rect.y - 5))

        pygame.draw.rect(surface, self.current_color, self.rect, border_radius=15)
        pygame.draw.rect(surface, (255, 255, 255, 100), self.rect, 3, border_radius=15)

        text_surf = font_medium.render(self.text, True, WHITE)
        text_rect = text_surf.get_rect(center=self.rect.center)
        surface.blit(text_surf, text_rect)

    def is_clicked(self, pos):
        return self.rect.collidepoint(pos)

