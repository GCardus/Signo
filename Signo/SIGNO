class Particle:
    def __init__(self, pos, vel, color, lifetime=0.5, size=3):
        self.pos = list(pos)
        self.vel = list(vel)
        self.color = color
        self.start_time = time.time()
        self.lifetime = lifetime
        self.size = size

    def update(self, current_time):
        elapsed = current_time - self.start_time
        if elapsed < self.lifetime:
            self.pos[0] += self.vel[0]
            self.pos[1] += self.vel[1]
            self.vel[1] += 0.1
            return True
        return False

    def draw(self, surface):
        pygame.draw.circle(surface, self.color, (int(self.pos[0]), int(self.pos[1])), self.size)

class FloatingText:
    def __init__(self, text, pos, color=RED, duration=0.8, size=36):
        self.text = text
        self.pos = list(pos)
        self.color = color
        self.start_time = time.time()
        self.duration = duration
        self.size = size
        self.font = pygame.font.Font(None, size)

    def update(self, current_time):
        elapsed = current_time - self.start_time
        if elapsed < self.duration:
            self.pos[1] -= 0.8
            return True
        return False

    def draw(self, surface):
        alpha = 255 * (1 - (time.time() - self.start_time) / self.duration)
        surf = self.font.render(str(self.text), True, self.color)
        surf.set_alpha(alpha)
        surface.blit(surf, (int(self.pos[0]), int(self.pos[1])))

