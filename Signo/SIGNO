            pygame.draw.line(screen, GREEN, (letters_checkbox.x+12, letters_checkbox.y+22), (letters_checkbox.x+22, letters_checkbox.y+8), 3)
        letters_text = font_small.render(get_text("letters"), True, WHITE)
