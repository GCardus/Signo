def dictionary():
    alphabet = [chr(ord('A') + i) for i in range(26)]
    numbers = [str(i) for i in range(10)]
    categories = [
        {"title_key": "ALFABET", "open": False, "signs": [{"word": l, "desc_key": f"desc_{l}"} for l in alphabet]},
        {"title_key": "NÚMEROS", "open": False, "signs": [{"word": n, "desc_key": f"desc_{n}"} for n in numbers]}
    ]
    for cat in categories:
        for sign in cat["signs"]:
            get_sign_image(sign["word"])
    imatges_disponibles = sum(1 for cat in categories for sign in cat["signs"] if get_sign_image(sign["word"]) is not None)
    te_imatges = imatges_disponibles > 0
    CARD_H = 130 if te_imatges else 85
    search_text = ""
    search_active = False
    cursor_visible = True
    cursor_timer = 0
    search_bar_rect = pygame.Rect(120, 80, 300, 36)
    clear_btn_rect = pygame.Rect(430, 80, 36, 36)
    scroll_offset = 0
    SCROLL_SPEED = 30
    CAT_H = 45
    running = True
    while running:
        mouse_pos = pygame.mouse.get_pos()
        dt = clock.tick(60)
        cursor_timer += dt
        if cursor_timer > 500:
            cursor_visible = not cursor_visible
            cursor_timer = 0
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return
            if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                return
            if event.type == pygame.KEYDOWN and search_active:
                if event.key == pygame.K_BACKSPACE:
                    search_text = search_text[:-1]
                    if not search_text:
                        search_active = False
                elif event.unicode and event.unicode.isprintable():
                    search_text += event.unicode
                    search_active = True
            elif event.type == pygame.MOUSEBUTTONDOWN:
                if event.button == 1:
                    if clear_btn_rect.collidepoint(event.pos):
                        search_text = ""
                        search_active = False
                    elif search_bar_rect.collidepoint(event.pos):
                        search_active = True
                    else:
                        search_active = False
                    if not search_text:
                        y = 150 - scroll_offset
                        for cat in categories:
                            title_rect = pygame.Rect(80, y, WIDTH - 160, CAT_H)
                            if title_rect.collidepoint(event.pos):
                                cat["open"] = not cat["open"]
                            y += CAT_H
                            if cat["open"]:
                                y += len(cat["signs"]) * CARD_H
                elif event.button == 4:
                    scroll_offset = max(0, scroll_offset - SCROLL_SPEED)
                elif event.button == 5:
                    if search_text:
                        results = [s for c in categories for s in c["signs"] if search_text.lower() in s["word"].lower()]
                        total_h = 120 + len(results) * CARD_H
                    else:
                        total_h = 150
                        for c in categories:
                            total_h += CAT_H
                            if c["open"]:
                                total_h += len(c["signs"]) * CARD_H
                    max_scroll = max(0, total_h - HEIGHT + 100)
                    scroll_offset = min(max_scroll, scroll_offset + SCROLL_SPEED)
        draw_background(time.time())
        draw_text_with_shadow(screen, get_text("dict_title"), font_large, WHITE, (WIDTH//2, 40))
        pygame.draw.rect(screen, (50, 50, 70), search_bar_rect, border_radius=8)
        pygame.draw.rect(screen, WHITE, search_bar_rect, 2, border_radius=8)
        search_surf = font_small.render(search_text + ("|" if search_active and cursor_visible else ""), True, WHITE)
        screen.blit(search_surf, (search_bar_rect.x + 8, search_bar_rect.y + 8))
        if not search_text and not search_active:
            placeholder = font_small.render("Cerca...", True, GRAY)
            screen.blit(placeholder, (search_bar_rect.x + 8, search_bar_rect.y + 8))
        pygame.draw.circle(screen, RED, clear_btn_rect.center, 18)
        pygame.draw.circle(screen, WHITE, clear_btn_rect.center, 18, 2)
        clear_text = font_small.render("X", True, WHITE)
        screen.blit(clear_text, (clear_btn_rect.x + 12, clear_btn_rect.y + 8))
        if te_imatges:
            info_text = font_tiny.render(f"Imatges: {imatges_disponibles}/36", True, (150, 200, 150))
        else:
            info_text = font_tiny.render("Sense imatges", True, (200, 150, 150))
        screen.blit(info_text, (WIDTH - 200, 85))
        y = 150 - scroll_offset
        if search_text:
            results = [s for c in categories for s in c["signs"] if search_text.lower() in s["word"].lower()]
            for sign in results:
                if y + CARD_H > 60 and y < HEIGHT:
                    card_rect = pygame.Rect(100, y, WIDTH - 200, CARD_H)
                    pygame.draw.rect(screen, (50, 50, 70), card_rect, border_radius=10)
                    pygame.draw.rect(screen, BLUE, card_rect, 2, border_radius=10)
                    img = get_sign_image(sign["word"])
                    if img is not None:
                        img_rect = img.get_rect(center=(170, y + CARD_H // 2))
                        screen.blit(img, img_rect)
                        word_text = font_medium.render(sign["word"], True, (255, 215, 0))
                        screen.blit(word_text, (240, y + 20))
                        desc_text = font_small.render(get_text(sign["desc_key"]), True, WHITE)
                        screen.blit(desc_text, (240, y + 75))
                    else:
                        word_text = font_medium.render(sign["word"], True, (255, 215, 0))
                        screen.blit(word_text, (120, y + 15))
                        desc_text = font_small.render(get_text(sign["desc_key"]), True, WHITE)
                        screen.blit(desc_text, (120, y + 50))
                y += CARD_H
        else:
            for cat in categories:
                title_rect = pygame.Rect(80, y, WIDTH - 160, CAT_H)
                if title_rect.collidepoint(mouse_pos):
                    pygame.draw.rect(screen, (100, 160, 210), title_rect, border_radius=8)
                else:
                    pygame.draw.rect(screen, (70, 130, 180), title_rect, border_radius=8)
                pygame.draw.rect(screen, WHITE, title_rect, 2, border_radius=8)
                icon = "▼" if cat["open"] else "▶"
                icon_text = font_medium.render(icon, True, WHITE)
                screen.blit(icon_text, (title_rect.x + 15, title_rect.y + 8))
                cat_text = font_medium.render(get_text(cat["title_key"]), True, WHITE)
                screen.blit(cat_text, (title_rect.x + 45, title_rect.y + 8))
                y += CAT_H
                if cat["open"]:
                    for sign in cat["signs"]:
                        if y + CARD_H > 60 and y < HEIGHT:
                            card_rect = pygame.Rect(100, y, WIDTH - 200, CARD_H)
                            pygame.draw.rect(screen, (50, 50, 70), card_rect, border_radius=10)
                            pygame.draw.rect(screen, BLUE, card_rect, 2, border_radius=10)
                            img = get_sign_image(sign["word"])
                            if img is not None:
                                img_rect = img.get_rect(center=(170, y + CARD_H // 2))
                                screen.blit(img, img_rect)
                                word_text = font_medium.render(sign["word"], True, (255, 215, 0))
                                screen.blit(word_text, (240, y + 20))
                                desc_text = font_small.render(get_text(sign["desc_key"]), True, WHITE)
                                screen.blit(desc_text, (240, y + 75))
                            else:
                                word_text = font_medium.render(sign["word"], True, (255, 215, 0))
                                screen.blit(word_text, (120, y + 15))
                                desc_text = font_small.render(get_text(sign["desc_key"]), True, WHITE)
                                screen.blit(desc_text, (120, y + 50))
                        y += CARD_H
        pygame.draw.rect(screen, GRAY, (10, 10, 80, 40), border_radius=10)
        back_text = font_small.render(get_text("back"), True, WHITE)
        screen.blit(back_text, (15, 18))
        pygame.display.flip()
        clock.tick(60)

# ---------- Joc principal ----------
def game_loop():
    global webcam, dificultat, volum, high_score, use_letters, use_numbers, detector_mans

    if detector_mans is None:
        screen.fill((0,0,0))
        error_surf = font_medium.render("ERROR: No es pot carregar el detector de mans.", True, RED)
        error_surf2 = font_medium.render("Assegura't que el fitxer 'hand_landmarker.task' existeix.", True, RED)
        screen.blit(error_surf, (WIDTH//2 - error_surf.get_width()//2, HEIGHT//2 - 50))
        screen.blit(error_surf2, (WIDTH//2 - error_surf2.get_width()//2, HEIGHT//2 + 10))
        pygame.display.flip()
        time.sleep(3)
        return True

    if webcam is None or not webcam.isOpened():
        webcam = cv2.VideoCapture(0)

    lletres_detectables = ["A","B","C","D","E","F","G","H","I","L","O","P","Q","R","S","T","U","V","W","Y"]
    numeros_detectables = [str(i) for i in range(10)]

    all_gestures = []
    if use_letters:
        all_gestures.extend([("lletra", l) for l in lletres_detectables])
    if use_numbers:
        all_gestures.extend([("numero", n) for n in numeros_detectables])
    if not all_gestures:
        all_gestures = [("lletra", l) for l in lletres_detectables] + [("numero", n) for n in numeros_detectables]

    tipus_actual, current_gesture = random.choice(all_gestures)
    sistema = SistemaJocUniversal()
    sistema.iniciar_nivell(current_gesture, tipus_actual)

    player_health = 100
    max_player_health = 100
    attack_damage = 20

    if dificultat == "Fàcil":
        enemy_attack_cooldown = 20.0
        enemy_damage = 5
        enemy_health = 100
        max_enemy_health = 100
        monster_color = (100, 200, 100)
        monster_eye_color = (0, 0, 0)
        monster_horn = False
        monster_scale = False
    elif dificultat == "Difícil":
        enemy_attack_cooldown = 10.0
        enemy_damage = 15
        enemy_health = 500
        max_enemy_health = 500
        monster_color = (150, 50, 50)
        monster_eye_color = (255, 80, 80)
        monster_horn = True
        monster_scale = True
    else:
        enemy_attack_cooldown = 15.0
        enemy_damage = 10
        enemy_health = 200
        max_enemy_health = 200
        monster_color = (200, 130, 50)
        monster_eye_color = (0, 0, 0)
        monster_horn = True
        monster_scale = False

    last_enemy_attack_time = time.time()
    battle_active = True
    victory = False
    last_gesture_time = 0

    score = 0
    combo = 0
    consecutive_hits = 0
    powerup_cooldown = 0
    last_hit_time = 0

    attack_active = False
    attack_start_time = 0
    attack_duration = 0.35
    fire_trail = []
    sword_angle = 0
    sword_animating = False

    floating_texts = []
    particles = []

    detection_msg = ""
    detection_color = WHITE
    detection_time = 0

    shake_intensity = 0
    shake_decay = 0.85

    def play_sound(name):
        if name in sounds and sounds[name]:
            sounds[name].play()

    show_tutorial = True
    tutorial_start_time = 0
    paused = False

    start_time = time.time()

    running = True
    while running:
        current_time = time.time()
        t_global = current_time - start_time

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    if battle_active:
                        return True
                if event.key == pygame.K_p and battle_active:
                    paused = not paused

        if paused:
            draw_background(t_global)
            overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            overlay.fill((0,0,0,180))
            screen.blit(overlay, (0,0))
            draw_text_with_shadow(screen, get_text("pause"), font_large, WHITE, (WIDTH//2, HEIGHT//2))
            pygame.display.flip()
            clock.tick(30)
            continue

        ret, frame = webcam.read()
        if not ret:
            continue

        h, w = frame.shape[:2]

        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb_frame)
        results_mans = detector_mans.detect(mp_image)
        hand_landmarks = results_mans.hand_landmarks[0] if results_mans.hand_landmarks else None

        if hand_landmarks:
            draw_hand_landmarks(frame, hand_landmarks, w, h)

        if hand_landmarks:
            msg, color, completed = sistema.actualitzar(hand_landmarks)
            detection_msg = msg
            detection_color = color
            detection_time = current_time
            if completed:
                last_gesture_time = current_time
                enemy_health -= attack_damage
                play_sound("hit")
                shake_intensity = 10
                floating_texts.append(FloatingText(f"-{attack_damage}", (MONSTER_POS[0], MONSTER_POS[1]-30), ORANGE, size=40))
                for _ in range(15):
                    particles.append(Particle((MONSTER_POS[0]+random.randint(-30,30), MONSTER_POS[1]+random.randint(-20,20)),
                                              (random.uniform(-5,5), random.uniform(-5,5)), (255,100+random.randint(0,100),0), 0.6, random.randint(2,5)))
                base_points = 10
                combo_multiplier = 1 + combo*0.1
                points = int(base_points * combo_multiplier)
                score += points
                floating_texts.append(FloatingText(f"+{points}", (MONSTER_POS[0], MONSTER_POS[1]-50), YELLOW, 0.6, 30))
                consecutive_hits += 1
                combo = consecutive_hits
                last_hit_time = current_time
                last_enemy_attack_time = current_time
                sword_animating = True
                sword_angle = 30
                attack_active = True
                attack_start_time = current_time
                fire_trail = []
                if enemy_health <= 0:
                    enemy_health = 0
                    battle_active = False
                    victory = True
                    play_sound("victory")
                    if score > high_score:
                        high_score = score
                        save_config()
                else:
                    new_tipus, new_gesture = random.choice(all_gestures)
                    while new_gesture == current_gesture and new_tipus == tipus_actual:
                        new_tipus, new_gesture = random.choice(all_gestures)
                    current_gesture = new_gesture
                    tipus_actual = new_tipus
                    sistema.iniciar_nivell(current_gesture, tipus_actual)
        else:
            detection_msg = "No es detecta cap mà"
            detection_color = RED
            detection_time = current_time
            sistema.actualitzar(None)

        if battle_active and current_time - last_enemy_attack_time >= enemy_attack_cooldown:
            player_health -= enemy_damage
            last_enemy_attack_time = current_time
            play_sound("hit")
            shake_intensity = 15
            floating_texts.append(FloatingText(f"-{enemy_damage}", (PLAYER_POS[0], PLAYER_POS[1]-30), RED, size=40))
            for _ in range(10):
                particles.append(Particle((PLAYER_POS[0]+random.randint(-20,20), PLAYER_POS[1]+random.randint(-20,20)),
                                          (random.uniform(-3,3), random.uniform(-3,3)), RED, 0.5, random.randint(2,4)))
            if player_health <= 0:
                player_health = 0
                battle_active = False
                victory = False
                play_sound("defeat")
                if score > high_score:
                    high_score = score
                    save_config()

        if current_time - last_hit_time > 2.0:
            combo = 0
            consecutive_hits = 0

        if consecutive_hits >= 3 and powerup_cooldown == 0 and battle_active and player_health < max_player_health:
            powerup_cooldown = 3
            heal = 10
            player_health = min(max_player_health, player_health + heal)
            play_sound("powerup")
            floating_texts.append(FloatingText(get_text("powerup"), (PLAYER_POS[0], PLAYER_POS[1]-40), GREEN, 1.0, 30))
            particles.extend([Particle((PLAYER_POS[0]+random.randint(-30,30), PLAYER_POS[1]+random.randint(-20,20)),
                                       (random.uniform(-3,3), random.uniform(-3,3)), GREEN, 0.6, random.randint(2,5)) for _ in range(20)])
        if powerup_cooldown > 0:
            powerup_cooldown = max(0, powerup_cooldown - 0.033)

        if sword_animating:
            sword_angle -= 10
            if sword_angle <= -30:
                sword_animating = False

        floating_texts = [ft for ft in floating_texts if ft.update(current_time)]
        particles = [p for p in particles if p.update(current_time)]

        shake_offset = (0, 0)
        if shake_intensity > 0.5:
            shake_offset = (random.randint(-int(shake_intensity), int(shake_intensity)),
                            random.randint(-int(shake_intensity), int(shake_intensity)))
            shake_intensity *= shake_decay

        draw_background(t_global)

        draw_text_with_shadow(screen, get_text("battle_title"), font_medium, YELLOW, (WIDTH//2 + shake_offset[0], 40 + shake_offset[1]))
        draw_health_bar_glow(50 + shake_offset[0], 110 + shake_offset[1], 400, 30, player_health, max_player_health, GREEN)
        draw_text_with_shadow(screen, f"{get_text('player')}: {player_health} {get_text('hp')}", font_small, WHITE, (50 + shake_offset[0] + 200, 85 + shake_offset[1]))
        draw_health_bar_glow(WIDTH - 450 + shake_offset[0], 110 + shake_offset[1], 400, 30, enemy_health, max_enemy_health, RED)
        draw_text_with_shadow(screen, f"{get_text('monster')}: {enemy_health} {get_text('hp')}", font_small, WHITE, (WIDTH - 450 + shake_offset[0] + 200, 85 + shake_offset[1]))
        draw_text_with_shadow(screen, f"{get_text('score')}: {score}", font_small, YELLOW, (30 + shake_offset[0], 30 + shake_offset[1]))
        if combo > 0:
            draw_text_with_shadow(screen, f"{get_text('combo')} {combo:.0f}", font_small, PURPLE, (30 + shake_offset[0], 65 + shake_offset[1]))
        draw_text_with_shadow(screen, f"{get_text('high_score')}: {high_score}", font_small, (200,200,200), (WIDTH - 200 + shake_offset[0], 30 + shake_offset[1]))

        draw_player(sword_angle)
        flash = current_time - last_gesture_time < 0.1 and battle_active
        draw_monster(MONSTER_POS, monster_color, monster_eye_color, monster_horn, monster_scale, flash)

        if attack_active:
            fire_trail = draw_fireball(current_time, attack_start_time, attack_duration,
                                       PLAYER_POS, MONSTER_POS, fire_trail)
            if not fire_trail and current_time - attack_start_time >= attack_duration:
                attack_active = False

        for ft in floating_texts:
            ft.draw(screen)
        for p in particles:
            p.draw(screen)

        color_gest = BLUE if tipus_actual == "lletra" else ORANGE
        draw_text_with_shadow(screen, f"{get_text('do_gesture')} {current_gesture}", font_large, color_gest, (WIDTH//2 + shake_offset[0], HEIGHT//2 - 80 + shake_offset[1]))

        if detection_msg and current_time - detection_time < 1.0:
            draw_text_with_shadow(screen, detection_msg, font_small, detection_color, (WIDTH//2 + shake_offset[0], HEIGHT//2 - 40 + shake_offset[1]))

        time_since_last_attack = current_time - last_enemy_attack_time
        cooldown_remaining = max(0, enemy_attack_cooldown - time_since_last_attack)
        if cooldown_remaining > 0 and battle_active:
            draw_text_with_shadow(screen, f"{get_text('next_attack')} {cooldown_remaining:.1f}s", font_small, RED, (WIDTH//2 + shake_offset[0], HEIGHT//2 - 20 + shake_offset[1]))

        if show_tutorial and battle_active:
            tutorial_start_time = current_time
            show_tutorial = False
        if current_time - tutorial_start_time < 3.0 and not show_tutorial:
            tutorial_surface = pygame.Surface((WIDTH, 60), pygame.SRCALPHA)
            tutorial_surface.fill((0,0,0,200))
            screen.blit(tutorial_surface, (0, HEIGHT-80))
            draw_text_with_shadow(screen, get_text("tutorial"), font_small, WHITE, (WIDTH//2, HEIGHT-70))

        frame_small = cv2.resize(frame, (320, 240))
        frame_rgb = cv2.cvtColor(frame_small, cv2.COLOR_BGR2RGB)
        frame_rot = np.rot90(frame_rgb)
        pygame_frame = pygame.surfarray.make_surface(frame_rot)
        screen.blit(pygame_frame, (WEBCAM_POS[0] + shake_offset[0], WEBCAM_POS[1] + shake_offset[1]))
        draw_text_with_shadow(screen, get_text("demo_text"), font_small, GRAY, (WIDTH//2, HEIGHT-30))

        if not battle_active:
            overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            overlay.fill((0,0,0,200))
            screen.blit(overlay, (0,0))
            if victory:
                draw_text_with_shadow(screen, get_text("victory"), font_large, GREEN, (WIDTH//2, HEIGHT//2 - 100))
                for _ in range(50):
                    particles.append(Particle((WIDTH//2, HEIGHT//2), (random.uniform(-8,8), random.uniform(-8,8)), (255,215,0), 1.5, random.randint(2,6)))
            else:
                draw_text_with_shadow(screen, get_text("defeat"), font_large, RED, (WIDTH//2, HEIGHT//2 - 100))
            draw_text_with_shadow(screen, get_text("continue_text"), font_medium, WHITE, (WIDTH//2, HEIGHT//2 + 50))
            pygame.display.flip()
            waiting = True
            while waiting:
                for event in pygame.event.get():
                    if event.type == pygame.QUIT:
                        return False
                    if event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:
                            return True
                        else:
                            waiting = False
                            return True
            return True

        pygame.display.flip()
        clock.tick(30)
    return True

# ---------- Punt d'entrada ----------
def main():
    while True:
        action = main_menu()
        if action == "play":
            if not game_loop():
                break
        elif action == "dictionary":
            dictionary()
        elif action == "settings":
            settings_menu()
        elif action == "exit":
            break

    if webcam is not None and webcam.isOpened():
        webcam.release()
    if detector_mans is not None:
        detector_mans.close()
    cv2.destroyAllWindows()
    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()