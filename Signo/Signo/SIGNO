    tip_y = sword_y - 15 + 15 * np.sin(angle_rad)
    pygame.draw.line(screen, (200, 200, 250), (sword_x, sword_y), (tip_x, tip_y), 6)
    pygame.draw.polygon(screen, (220, 220, 255), [(tip_x, tip_y), (tip_x - 5, tip_y - 5), (tip_x + 5, tip_y - 5)])

